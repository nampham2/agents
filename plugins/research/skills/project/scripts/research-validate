#!/usr/bin/env bash
# Host-neutral launcher for validate_workspace.py.
set -euo pipefail

source=${BASH_SOURCE[0]}
while [[ -L $source ]]; do
  directory=$(cd -P "$(dirname "$source")" && pwd)
  source=$(readlink "$source")
  [[ $source != /* ]] && source=$directory/$source
done
here=$(cd -P "$(dirname "$source")" && pwd)
script=$here/validate_workspace.py

if [[ ! -f $script ]]; then
  echo "error: $script is missing; the launcher must stay beside the project scripts" >&2
  exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "error: python3 is not on PATH; it is what runs validate_workspace.py" >&2
  exit 1
fi

exec python3 "$script" "$@"
