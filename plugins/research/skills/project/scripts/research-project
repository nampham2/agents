#!/usr/bin/env bash
# Host-neutral launcher for manage_workspace.py.
set -euo pipefail

source=${BASH_SOURCE[0]}
while [[ -L $source ]]; do
  directory=$(cd -P "$(dirname "$source")" && pwd)
  source=$(readlink "$source")
  [[ $source != /* ]] && source=$directory/$source
done
here=$(cd -P "$(dirname "$source")" && pwd)
script=$here/manage_workspace.py

if [[ ! -f $script ]]; then
  echo "error: $script is missing; the launcher must stay beside the project scripts" >&2
  exit 1
fi

selector=$here/python_select.sh
if [[ ! -f $selector ]]; then
  echo "error: $selector is missing; the launcher must stay beside the project scripts" >&2
  exit 1
fi

# shellcheck source=python_select.sh
source "$selector"
research_run_python "$script" "$@"
